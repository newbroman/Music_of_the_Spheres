000000000.0,"disc":[1969,"チュリュモフとゲラシメンコ"],"craft":[["ロゼッタ","周回","2014–16"],["フィラエ","着陸","2014"]],"note":"二つのかたまりからなる「ゴムのアヒル」のような彗星です。ロゼッタが 2 年間周回し、着陸機フィラエが 2014 年に史上初の彗星着陸を果たしました。"},"swift":{"kind":"comet","d":26,"disc":[1862,"スウィフトとタットル"],"note":"ペルセウス座流星群の母天体で、地球の近くを何度も通る天体として知られている中で最大です。次の回帰は 2126 年です。","tc":"comet"},"tempel":{"kind":"comet","d":3.6,"alb":0.06,"disc":[1865,"テンペルとタットル"],"note":"しし座流星群の母天体で、1833 年と 1966 年には大流星雨となりました。","tc":"comet"},"halebopp":{"kind":"comet","d":60,"approx":1,"alb":0.04,"disc":[1995,"ヘールとボップ"],"note":"1996〜97 年に記録的な 18 か月間も肉眼で見え、20 世紀で最も明るい彗星の一つになりました。"},"selene":{"kind":"moon","d":3475,"rot":"sync","alb":0.12,"rho":3.34,"m":7.35e+22,"craft":[["ルナ2号","衝突","1959"],["アポロ11号","着陸","1969"],["嫦娥4号","着陸","2019"]],"note":"若い地球への巨大衝突で飛び散った破片からできたと考えられています。1969 年から 1972 年にかけて 12 人の宇宙飛行士が月面を歩きました。"},"phobos":{"kind":"moon","dim":[25.9,22.6,18.3],"rot":"sync","alb":0.071,"rho":1.85,"m":1.06e+16,"disc":[1877,"ホール"],"craft":[["マリナー9号","観測","1971"],["バイキング1号","フライバイ","1977–78"],["マーズ・エクスプレス","フライバイ","2004–"]],"note":"火星の自転より速く公転するため、西から昇ります。らせんを描いて火星に近づいており、約 3000 万〜5000 万年後に砕けると考えられています。"},"deimos":{"kind":"moon","dim":[16.1,11.8,10.2],"rot":"sync","alb":0.068,"rho":1.47,"m":1440000000000000.0,"disc":[1877,"ホール"],"craft":[["バイキング2号","フライバイ","1977"],["ホープ","フライバイ","2023"]],"note":"火星の二つの衛星のうち小さく外側にある方で、厚い塵に覆われてなめらかです。"},"amalthea":{"kind":"moon","dim":[252,146,126],"rot":"sync","alb":0.09,"rho":0.86,"m":2.08e+18,"disc":[1892,"バーナード"],"craft":[["ボイジャー1号","フライバイ","1979"],["ガリレオ","フライバイ","2002"]],"note":"表面は太陽系で最も赤く、すかすかなので、氷と岩がゆるく集まっただけかもしれません。"},"io":{"kind":"moon","d":3643,"rot":"sync","alb":0.62,"rho":3.53,"m":8.93e+22,"disc":[1610,"ガリレオ"],"craft":[["ボイジャー1号","フライバイ","1979"],["ガリレオ","フライバイ","1995–2003"],["ジュノー","フライバイ","2023–24"]],"note":"知られている中で最も火山活動が活発な天体で、木星の潮汐で温められた数百の活火山があります。"},"europa":{"kind":"moon","d":3122,"rot":"sync","alb":0.67,"rho":3.01,"m":4.8e+22,"disc":[1610,"ガリレオ"],"craft":[["ボイジャー2号","フライバイ","1979"],["ガリレオ","フライバイ","1996–